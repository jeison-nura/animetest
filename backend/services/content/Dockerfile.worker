# syntax=docker/dockerfile:1.7
# Worker de transcode: necesita ffmpeg en runtime → alpine completo, no distroless
FROM golang:1.25-alpine AS build
RUN apk add --no-cache ffmpeg
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download || true
COPY . .
RUN go mod tidy && CGO_ENABLED=0 go build -ldflags="-s -w" -o /bin/transcode-worker ./cmd/transcode-worker

FROM alpine:3.20
RUN apk add --no-cache ffmpeg ca-certificates && adduser -D -u 65532 worker
COPY --from=build /bin/transcode-worker /bin/transcode-worker
ENV WORK_DIR=/tmp/transcode
USER 65532
ENTRYPOINT ["/bin/transcode-worker"]
